<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>TestCaseSource</Title>
			<Author>SSeelos</Author>
			<Description>Data Test method</Description>
			<Shortcut>TestCaseSource_Data_NUnit</Shortcut>
		</Header>
		<Snippet>
			<Code Language="CSharp">
				<![CDATA[
[TestCaseSource(nameof($methodname$_Data))]
public void $methodname$($typeA$ $paramA$, $typeB$ $paramB$)
{
	
}

public static IEnumerable<$datatype$[]> $methodname$_Data()
{
	yield return new $datatype$[]{$dataA$, $dataB$};
}
				]]>
			</Code>
      <Imports>
        <Import>
          <Namespace>NUnit.Framework</Namespace>
        </Import>
      </Imports>
            <Declarations>
                <Literal>
                    <ID>methodname</ID>
                    <Default>Test</Default>
                </Literal>
        <Literal>
          <ID>typeA</ID>
          <Default>object</Default>
        </Literal>
        <Literal>
          <ID>paramA</ID>
          <Default>param</Default>
        </Literal>
        <Literal>
          <ID>typeB</ID>
          <Default>object</Default>
        </Literal>
        <Literal>
          <ID>paramB</ID>
          <Default>param</Default>
        </Literal>
        <Literal>
          <ID>datatype</ID>
          <Default>object</Default>
        </Literal>
        <Literal>
          <ID>dataA</ID>
          <Default>"dataA"</Default>
        </Literal>
        <Literal>
          <ID>dataB</ID>
          <Default>"dataB"</Default>
        </Literal>
	        </Declarations>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>