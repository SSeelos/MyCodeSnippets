<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>SerializeFieldProperty</Title>
			<Author>SSeelos</Author>
			<Description>property with the field: SerializeField attribute</Description>
			<Shortcut>SerializeFieldProperty</Shortcut>
		</Header>
		<Snippet>
			<Code Language="CSharp">
			<![CDATA[
[field: SerializeField]
public $type$ $name$ { get; private set; }
            ]]>
			</Code>
            <Declarations>
                <Literal>
                    <ID>type</ID>
                    <ToolTip>type</ToolTip>
                    <Default>GameObject</Default>
                </Literal>
                <Literal>
                    <ID>name</ID>
                    <ToolTip>property name</ToolTip>
                    <Default>Property</Default>
                </Literal>
	        </Declarations>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>