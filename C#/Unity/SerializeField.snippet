<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>SerializeField</Title>
			<Author>SSeelos</Author>
			<Description>field with the SerializeField attribute</Description>
			<Shortcut>SerializeField</Shortcut>
		</Header>
		<Snippet>
			<Code Language="CSharp">
			<![CDATA[
[SerializeField] $type$ $name$;
            ]]>
			</Code>
            <Declarations>
                <Literal>
                    <ID>type</ID>
                    <ToolTip>type</ToolTip>
                    <Default>GameObject</Default>
                </Literal>
                <Literal>
                    <ID>name</ID>
                    <ToolTip>field name</ToolTip>
                    <Default>field</Default>
                </Literal>
	        </Declarations>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>